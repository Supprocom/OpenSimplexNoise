<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Supprocom.OpenSimplexNoise</RootNamespace>
    <AssemblyName>Supprocom.OpenSimplexNoise</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Supprocom.OpenSimplexNoise</PackageId>
    <Version>0.1.4</Version>
    <Authors>Supprocom</Authors>
    <Company>Supprocom</Company>
    <Copyright>Copyright (C) 2026 mkn8rn</Copyright>
    <PackageLicenseFile>PACKAGE-LICENSE.txt</PackageLicenseFile>
    <Description>Commercial or AGPL-3.0. A deterministic C# implementation of OpenSimplex Noise with allocation-free caller-owned state APIs.</Description>
    <PackageDescription>Commercial or AGPL-3.0. A deterministic C# implementation of OpenSimplex Noise with allocation-free initialization and two-dimensional, three-dimensional, and four-dimensional evaluation.</PackageDescription>
    <PackageProjectUrl>https://github.com/Supprocom/OpenSimplexNoise</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>opensimplex;noise;procedural-generation;allocation-free;span;2d;3d;4d</PackageTags>
    <PackageReleaseNotes>Dual-licensed: Commercial or AGPL-3.0. The Supprocom Commercial License 2.0 comes with a Patreon membership (https://www.patreon.com/cw/mkn8rn); see the COMMERCIAL-LICENSE file.
Security support until November 2031</PackageReleaseNotes>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\packages\</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <SourceRevisionId Condition="'$(RepositoryCommit)' != ''">$(RepositoryCommit)</SourceRevisionId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <None Include="..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\NOTICE" Pack="true" PackagePath="" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="THIRD-PARTY-NOTICES.md" />
    <AssemblyMetadata Include="RepositoryCommit" Value="$(RepositoryCommit)" Condition="'$(RepositoryCommit)' != ''" />
  </ItemGroup>

  <Import Project="..\build\PackageReadme.targets" />
  <!-- The package license file is generated from the repository's COMMERCIAL-LICENSE and LICENSE files. -->
  <PropertyGroup>
    <SupprocomPackageLicensePath>$(BaseIntermediateOutputPath)PACKAGE-LICENSE.txt</SupprocomPackageLicensePath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(SupprocomPackageLicensePath)" Pack="true" PackagePath="PACKAGE-LICENSE.txt" Visible="false" />
  </ItemGroup>
  <Target Name="WriteSupprocomPackageLicense" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <PropertyGroup>
      <_SupprocomCommercialText>$([MSBuild]::Escape($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../COMMERCIAL-LICENSE').TrimEnd())))</_SupprocomCommercialText>
      <_SupprocomAgplText>$([MSBuild]::Escape($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../LICENSE').TrimEnd())))</_SupprocomAgplText>
      <_SupprocomPackageLicenseText>Commercial or AGPL-3.0

This package is available under your choice of two licenses:
- the Supprocom Commercial License 2.0, for businesses with a Patreon membership (https://www.patreon.com/cw/mkn8rn)%3B or
- the GNU Affero General Public License, version 3 (AGPL-3.0).

Both texts follow. For each version, the COMMERCIAL-LICENSE file in the project's GitHub repository at the commit this package was built from prevails over this copy.

==============================================================================
$(_SupprocomCommercialText)

==============================================================================
$(_SupprocomAgplText)</_SupprocomPackageLicenseText>
    </PropertyGroup>
    <WriteLinesToFile File="$(SupprocomPackageLicensePath)" Lines="$(_SupprocomPackageLicenseText)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
