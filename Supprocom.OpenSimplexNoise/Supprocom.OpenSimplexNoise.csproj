<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Supprocom.OpenSimplexNoise</RootNamespace>
    <AssemblyName>Supprocom.OpenSimplexNoise</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Supprocom.OpenSimplexNoise</PackageId>
    <Version>0.1.2</Version>
    <Authors>Supprocom</Authors>
    <Company>Supprocom</Company>
    <Copyright>Copyright (C) 2026 mkn8rn</Copyright>
    <Description>A deterministic C# implementation of OpenSimplex Noise with allocation-free caller-owned state APIs.</Description>
    <PackageDescription>A deterministic C# implementation of OpenSimplex Noise with allocation-free initialization and two-dimensional, three-dimensional, and four-dimensional evaluation.</PackageDescription>
    <PackageLicenseExpression>AGPL-3.0-only AND Unlicense</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Supprocom/OpenSimplexNoise</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>opensimplex;noise;procedural-generation;allocation-free;span;2d;3d;4d</PackageTags>
    <PackageReleaseNotes>Enforces the complete analyzer gate, documents and tracks the existing public API, and identifies overlapping initialization buffers. Preserves exact noise outputs and allocation-free caller-owned state.</PackageReleaseNotes>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\packages\</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <SourceRevisionId Condition="'$(RepositoryCommit)' != ''">$(RepositoryCommit)</SourceRevisionId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <None Include="..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\NOTICE" Pack="true" PackagePath="" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="THIRD-PARTY-NOTICES.md" />
    <AssemblyMetadata Include="RepositoryCommit" Value="$(RepositoryCommit)" Condition="'$(RepositoryCommit)' != ''" />
  </ItemGroup>

  <Import Project="..\build\PackageReadme.targets" />
</Project>
