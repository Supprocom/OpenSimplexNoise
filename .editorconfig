root = true

[*.cs]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
csharp_style_namespace_declarations = file_scoped
csharp_style_var_for_built_in_types = false
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = false

# Include informational diagnostics in the build gate.
dotnet_analyzer_diagnostic.severity = warning

# Prefer the SDK rule when these analyzers report the same diagnostic.
# CA2201 covers reserved exception types; CA1724 covers namespace/type conflicts.
dotnet_diagnostic.MA0012.severity = none
dotnet_diagnostic.MA0049.severity = none
# IDE0048 owns parentheses for clarity.
dotnet_diagnostic.RCS1123.severity = none
